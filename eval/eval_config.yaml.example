# Eval run configuration
# Copy to eval_config.yaml and customize for your setup.

output_dir: ./output

# Only score annotations whose `annotator` field is in this list. Default
# ["human"] prevents accidentally evaluating a model against its own
# bootstrapped predictions. Use an empty list ([]) to accept all annotators,
# or include specific model names to evaluate against high-quality model
# annotations (e.g. ["human", "claude-opus-4-7"]).
allowed_annotators: ["human"]

configs:
  - name: haiku-sentence-level
    whisper:
      model: base
      language: en
    llm:
      provider: anthropic
      model: claude-haiku-4-5-20251001
    prompt: default
    min_confidence: 0.5

  - name: sonnet-word-level
    whisper:
      model: base
      language: en
      word_timestamps: true
    llm:
      provider: anthropic
      model: claude-sonnet-4-20250514
    prompt: default
    min_confidence: 0.5
